                "endless_mode": {
                    "description": "If set to true, the endless mode is activated. After completing the level, a next one will be started immediately. The player won't be able to win at all. Useful for 'time attack' missions (e.g. destroy X objects in Y seconds).",
                    "type": "boolean"
                },
                "theme": {
                    "description": "A background/theme used in the current level",
                    "type": "string",
                    "values": ["Field", "Volcano", "Sea"]
                },
                "powerup_earthquake": {
                    "description": "Set to false to completely disable the earthquake powerup",
                    "type": "boolean"
                }
            },
            "override": {
                "hide_ui": {
                    "description": "What UI elements should be hidden?",
                    "type": "array",
                    "values": ["level_progress", "floating_score_points"]
                },
                "bomb_types": {
                    "description": "Set which bombs are available: accepts a list of bomb types",
                    "type": "array",
                    "values": ["dynamite", "implosive", "horizontal", "punch", "molotov"]
                },
                "bomb_points": {
                    "description": "Bomb points amount available to the player. Set to -1 for unlimited bomb points",
                    "type": "number",
                    "min": -1
