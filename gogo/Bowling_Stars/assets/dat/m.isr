        <string id="INS_PAGE1_TEXT1">
            <en>UPGRADE   .   AND BEAT YOUR\nOPPONENTS</en>
            <es>Mejora   .   y vence\na tus oponentes</es>
            <de>Verbessere   .   und besiege\ndeine Gegner</de>
            <it>Potenziate   .   e battete\ngli avversari</it>
            <fr>Améliorez   .   et battez\nvos adversaires</fr>
            <ru>Улучшайте   .   и побеждайте\nсвоих соперников</ru>
            <pt>Faça upgrade de   .   e vença\nseus adversários</pt>
        </string>

        <string id="INS_PAGE2_TEXT1">
            <en>EARN       TO UNLOCK NEW   .</en>
            <es>Gana        para\ndesbloquear nuevos    .</es>
            <de>Verdiene         um neue   \nfreizuschalten    .</de>
            <it>Guadagna         per\nsbloccare nuovi     .</it>
            <fr>Gagnez         pour\ndébloquer de nouvelles     .</fr>
            <ru>Заработайте         чтобы\nразблокировать новые     .</ru>
            <pt>Ganhe         para\ndesbloquear novos     .</pt>
        </string>

        <string id="INS_PAGE3_TEXT1">
            <en>SWIPING FAST WHEN THROWING\nGETS YOU MORE POWER</en>
            <es>Deslizar rápido al lanzar\nte da más potencia</es>
            <de>Durch schnelles Swipen\nbeim Werfen erhältst\ndu mehr Kraft</de>
            <it>Scorrendo velocemente il dito\ndurante il lancio si ottiene\nuna maggiore potenza</it>
            <fr>Glissez rapidement lorsque\nvous lancez pour obtenir\nplus de puissance</fr>
            <ru>Быстрые движения при\nброске дают вам\nбольше энергии</ru>
            <pt>Deslizar rapidamente\nao arremessar lhe\ndá mais força</pt>
        </string>

        <string id="INS_PAGE3_TITLE1">
            <en>SET POSITION</en>
            <es>Fijar posición</es>
            <de>Position festlegen</de>
            <it>Impostare la posizione</it>
            <fr>Définir la position</fr>
            <ru>Установите позицию</ru>
            <pt>Definir posição</pt>
        </string>

        <string id="INS_PAGE3_DESC1">
            <en>tap and move the ball\nin horizontal direction</en>
            <es>Toca y mueve la bola\nen dirección horizontal</es>
            <de>Tippe und bewege den Ball\nin horizontaler Richtung</de>
            <it>Tocca e sposta la palla\nin direzione orizzontale</it>
            <fr>Tapez et déplacez la\nballe à l'horizontale</fr>
            <ru>Нажмите и переместите мяч\nв горизонтальном направлении</ru>
            <pt>Toque e mova a bola na\ndireção horizontal</pt>
        </string>

        <string id="INS_PAGE3_TITLE2">
            <en>SET DIRECTION</en>
            <es>Establecer dirección</es>
            <de>Richtung einstellen</de>
            <it>Impostare la direzione</it>
            <fr>Définir la direction</fr>
            <ru>Установите направление</ru>
            <pt>Definir direção</pt>
        </string>

        <string id="INS_PAGE3_DESC2">
            <en>tap to side of the ball or hold\n and swipe to set the direction</en>
            <es>Toca a un lado de la bola\no mantén pulsado y desliza\npara establecer la dirección</es>
            <de>Tippe auf die Seite des Balls\nodernhalte und streiche,\num die Richtung festzulegen</de>
            <it>Tocca il lato della palla o tieni\npremuto e scorri per\nimpostarne la direzione</it>
            <fr>Tapez sur le côté de la balle\nou maintenez et glissez\npour définir la direction</fr>
            <ru>Нажмите на боковую сторону\nмяча или удерживайтеи проведите\nпальцем, чтобы задать направление</ru>
            <pt>Toque na lateral da bola\nou segure e deslize\npara definir a direção</pt>
        </string>

        <string id="INS_PAGE3_TITLE3">
            <en>SET ROTATION</en>
            <es>Establecer rotación</es>
            <de>Rotation einstellen</de>
            <it>Impostare la rotazione</it>
            <fr>Régler la rotation</fr>
            <ru>Задать вращение</ru>
            <pt>Definir rotação</pt>
        </string>

        <string id="INS_PAGE3_DESC3">
            <en>swipe backwards to activate\nthe spin</en>
            <es>Desliza hacia atrás\npara activar el giro</es>
            <de>Wische nach hinten,\num die Drehung zu aktivieren</de>
            <it>Passare il dito all'indietro\nper attivare la rotazione</it>
            <fr>Glissez vers l'arrière\npour activer la rotation</fr>
            <ru>Проведите пальцем назад,\nчтобы активировать вращение</ru>
            <pt>Passe o dedo para trás\npara ativar o giro</pt>
        </string>

        <string id="INS_PAGE3_TITLE4">
            <en>THROW!</en>
            <es>Lanza</es>
            <de>Werfen!</de>
            <it>Lancio!</it>
            <fr>Lancer!</fr>
            <ru>Бросайте!</ru>
            <pt>Lançar!</pt>
        </string>

        <string id="INS_PAGE3_DESC4">
            <en>swipe forward to throw\nthe ball</en>
            <es>Desliza el dedo hacia\ndelante para lanzar la pelota</es>
            <de>Wischen Sie nach vorne,\num den Ball zu werfen</de>
            <it>Passare il dito in avanti\nper lanciare la palla</it>
            <fr>Glissez vers l'avant\npour lancer la balle</fr>
            <ru>Проведите пальцем вперед,\nчтобы бросить мяч</ru>
            <pt>Passe o dedo para frente\npara lançar a bola</pt>
        </string>

        <string id="SPECIAL_EVENT">
            <en>SPECIAL EVENT</en>
            <es>Evento especial</es>
            <de>Spezialereignis</de>
            <it>Evento speciale</it>
