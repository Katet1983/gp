			<it>RIPRISTINA SUBITO [MANA]% DEL TUO MANA. IL TUO TURNO TERMINERÀ.</it>
			<pt>RESTAURA % DE [MANA]DE SEU MANÁ INSTANTANEAMENTE. TERMINA SUA VEZ.</pt>
			<ru>ВОССТАНОВЛЯЕТ МГНОВЕННО [MANA]% ВАШЕЙ МАНЫ. КОНЕЦ ВАШЕГО ПРЕВРАЩЕНИЯ.</ru>
		</string>
		<string id="MANA_POTION_BIG">
			<en>MANA POTION</en>
            <ja>魔力ポーション</ja>
            <no>MANADRIKK</no>
			<nl>MANA TOVERDRANKJE</nl>
			<de>MANA-TRANK</de>
			<es>POCIÓN DE MANA</es>
			<fr>POTION DE MANA</fr>
			<it>POZIONE DEL MANA</it>
			<pt>POÇÃO DE MANÁ</pt>
			<ru>ЭЛИКСИР МАНЫ</ru>
		</string>
		<string id="SPELL_DESC_MANA_POTION_BIG">
			<en>RESTORES [MANA]% OF YOUR MANA INSTANTLY. ENDS YOUR TURN.</en>
            <ja>キャラクターの魔力を[MANA]%回復させます。\n使用後、ターン終了。</ja>
            <no>NULLSTILLER [MANA]% AV DIN MANA UMIDDELBART. AVSLUTTER TUREN DIN.</no>
			<nl>HERSTEL ONMIDDELIJK [MANA]% VAN JE MANA. BEËINDIGT JOUW BEURT.</nl>
			<de>STELLT [MANA]% DEINES MANAS SOFORT WIEDER HER. DEIN ZUG IST BEENDET.</de>
			<es>RECUPERAS UN [MANA] % DE MANA AL INSTANTE. CUANDO LA USAS, TERMINA TU TURNO.</es>
			<fr>RESTAUREZ [MANA] % DE VOTRE MANA INSTANTANÉMENT. MET FIN À VOTRE TOUR.</fr>
			<it>RIPRISTINA SUBITO [MANA]% DEL TUO MANA. IL TUO TURNO TERMINERÀ.</it>
			<pt>RESTAURA % DE [MANA]DE SEU MANÁ INSTANTANEAMENTE. TERMINA SUA VEZ.</pt>
			<ru>ВОССТАНОВЛЯЕТ МГНОВЕННО [MANA]% ВАШЕЙ МАНЫ. КОНЕЦ ВАШЕГО ПРЕВРАЩЕНИЯ.</ru>
		</string>
		<string id="UPGRADE_SKILLS">
			<en>UPGRADE YOUR ATTRIBUTES TO GROW STRONGER AND STAND A CHANCE AGAINST TOUGHER OPPONENTS</en>
            <ja>属性スキルをアップグレードさせて成長し、さ\nらなる強敵とのバトルに備えましょう。</ja>
            <no>OPPGRADER DINE ATTRIBUTTER FOR Å BLI STERKERE OG HA EN SJANSE MOT TØFFERE MOTSTANDERE</no>
			<nl>VERBETER JE VAARDIGHEDEN OM STERKER TE WORDEN EN ZO KANS TE MAKEN TEGEN JE STERKERE TEGENSTANDERS.</nl>
			<de>VERBESSERE DEINE FÄHIGKEITEN, UM STÄRKER ZU WERDEN UND UM GEGEN STÄRKERE GEGNER BESTEHEN ZU KÖNNEN</de>
			<es>MEJORA TUS ATRIBUTOS PARA ADQUIRIR FUERZA Y PODER ENFRENTARTE A ENEMIGOS MÁS COMPLICADOS.</es>
			<fr>AMÉLIOREZ VOS CARACTÉRISTIQUES POUR DEVENIR PLUS FORT ET AVOIR UNE CHANCE CONTRE LES ADVERSAIRES LES PLUS PUISSANTS</fr>
			<it>POTENZIA I TUOI ATTRIBUTI PER DIVENTARE PIÙ FORTE E AVERE UN POSSIBILTÀ CONTRO GLI AVVERSARI PIÙ POTENTI</it>
			<pt>ATUALIZE SEUS ATRIBUTOS PARA SE FORTALECER E SE POSICIONAR CONTRA OPONENTES MAIS DUROS</pt>
			<ru>УЛУЧШИТЕ СВОИ НАВЫКИ, ЧТОБЫ БЫТЬ СИЛЬНЫМ, СТОЙКИМ ПРОТИВ ТРУДНЫХ ПРОТИВНИКОВ</ru>
		</string>

