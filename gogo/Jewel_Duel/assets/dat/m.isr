		<string id="SYMBOL TYPES">
			<en>SYMBOL TYPES</en>
            <ja>絵柄</ja>
            <no>SYMBOLTYPER</no>
			<nl>TYPE KARAKTERS</nl>
			<de>SYMBOLE</de>
			<es>SÍMBOLOS</es>
			<fr>SYMBOLES</fr>
			<it>SIMBOLI</it>
			<pt>SÍMBOLOS</pt>
			<ru>ТИПЫ СИМВОЛОВ</ru>
