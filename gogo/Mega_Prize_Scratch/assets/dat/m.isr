<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<stringresources>
    <strings>

      <string id="ONBOARDING_TEXT0">
          <en>Welcome friend!</en>
          <es>¡Bienvenido amigo!</es>
          <de>Willkommen Freund!</de>
          <it>Benvenuto amico!</it>
          <fr>Bienvenue à l'ami !</fr>
          <pt>Bem-vindo amigo!</pt>
          <ru>Добро пожаловать, друг!</ru>
      </string>

       <string id="ONBOARDING_TEXT1">
            <en>Click on the build button to start</en>
            <es>Haz clic en el botón de construcción para empezar</es>
            <de>Klicke auf die Schaltfläche "Bauen", um zu beginnen</de>
            <it>Clicca sul pulsante di costruzione per iniziare</it>
            <fr>Cliquez sur le bouton de construction pour commencer</fr>
            <pt>Clique no botão de construção para começar</pt>
            <ru>Нажмите на кнопку строительства, чтобы начать</ru>
       </string>

      <string id="ONBOARDING_TEXT2">
            <en>Scratch cards to earn coins</en>
            <es>Rasca tarjetas para ganar monedas</es>
            <de>Rubbelkarten, um Münzen zu verdienen</de>
            <it>Gratta le carte per guadagnare monete</it>
            <fr>Grattez des cartes pour gagner des pièces</fr>
            <pt>Raspe os cartões para ganhar moedas</pt>
            <ru>Скретч-карты, чтобы заработать монеты</ru>
       </string>

      <string id="ONBOARDING_TEXT3">
             <en>You are out of coins</en>
             <es>Te has quedado sin monedas</es>
             <de>Du hast keine Münzen mehr</de>
             <it>Hai finito le monete</it>
             <fr>Vous n'avez plus de pièces</fr>
             <pt>Você está sem moedas</pt>
             <ru>У вас закончились монеты</ru>
        </string>

          <string id="ONBOARDING_TEXT4">
             <en>Let’s earn some!</en>
             <es>¡Vamos a ganar algunas!</es>
             <de>Lass uns welche verdienen!</de>
             <it>Guadagniamone un po'!</it>
             <fr>Gagnons-en !</fr>
             <pt>Vamos ganhar algumas!</pt>
             <ru>Давайте заработаем немного!</ru>
           </string>

